    <!-- PPG Heart Rate Screen -->
    <string name="ppg_title">قياس دقات القلب (PPG)</string>
    <string name="ppg_subtitle">كاميرا الهاتف + الفلاش مع تصفية إشارة مزدوجة وفحص الحركة</string>
    <string name="ppg_permission_title">مطلوب إذن الكاميرا</string>
    <string name="ppg_permission_desc">يستخدم التطبيق الكاميرا الخلفية والفلاش لالتقاط تغيرات تدفق الدم في طرف الإصبع (تقنية PPG). لا يتم حفظ أي صور أو فيديو مطلقًا.</string>
    <string name="grant_permission">منح الإذن</string>
