    <string name="ble_status_ready">Prêt à recevoir la mesure automatiquement</string>
    <string name="ble_cuff_live">Pression brassard en direct</string>
    <string name="ble_no_devices">Aucun appareil trouvé. Activez le mode appairage Bluetooth sur votre tensiomètre.</string>
    <string name="ble_connect">Connecter</string>
